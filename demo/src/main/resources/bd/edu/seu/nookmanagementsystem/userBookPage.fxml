<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="610.0" prefWidth="930.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bd.edu.seu.nookmanagementsystem.User.userDeshboard.Features.userBookController">
   <children>
      <VBox spacing="20.0" layoutX="50.0" layoutY="30.0" prefWidth="500.0">
         <children>
            <Label style="-fx-text-fill: #2c3e50;" text="Add New Book Entry">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #7f8c8d;" text="Book Title:" />
                  <TextField fx:id="titleField" prefHeight="35.0" promptText="e.g. The Great Gatsby" style="-fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #7f8c8d;" text="Author Name:" />
                  <TextField fx:id="authorField" prefHeight="35.0" promptText="e.g. F. Scott Fitzgerald" style="-fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #7f8c8d;" text="Genre / Category:" />
                  <TextField fx:id="genreField" prefHeight="35.0" promptText="e.g. Fiction, Fantasy, History" style="-fx-background-radius: 5;" />
               </children>
            </VBox>

            <HBox spacing="20.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #7f8c8d;" text="Quantity:" />
                        <TextField fx:id="quantityField" prefHeight="35.0" promptText="e.g. 5" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #7f8c8d;" text="Price (৳ / Rent):" />
                        <TextField fx:id="priceField" prefHeight="35.0" promptText="e.g. 150" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #7f8c8d;" text="Description:" />
                  <TextArea fx:id="descriptionField" prefHeight="100.0" promptText="Enter brief book synopsis..." style="-fx-background-radius: 5;" wrapText="true" />
               </children>
            </VBox>

            <Button mnemonicParsing="false" onAction="#submitBook" prefHeight="40.0" prefWidth="500.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Add Book to Catalog">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
