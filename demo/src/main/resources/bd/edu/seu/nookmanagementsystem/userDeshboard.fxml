<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="670.0" prefWidth="1150.0" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bd.edu.seu.nookmanagementsystem.User.userDeshboard.userDeshboardController">
   <children>
      <!-- Side Navigation Panel -->
      <VBox alignment="TOP_CENTER" layoutX="0.0" layoutY="0.0" prefHeight="670.0" prefWidth="220.0" style="-fx-background-color: #2c3e50;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="40.0" />
         </padding>

         <!-- App Logo/Title -->
         <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Nook Library">
            <font>
               <Font name="System Bold" size="22.0" />
            </font>
            <VBox.margin>
               <Insets bottom="40.0" />
            </VBox.margin>
         </Label>

         <!-- Navigation Buttons -->
         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#userHome" prefHeight="37.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="Dashboard Home">
            <font>
               <Font size="14.0" />
            </font>
            <VBox.margin>
               <Insets bottom="15.0" />
            </VBox.margin>
         </Button>

         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#userBook" prefHeight="37.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 2; -fx-cursor: hand;" text="Add Nook Book">
            <font>
               <Font size="14.0" />
            </font>
            <VBox.margin>
               <Insets bottom="15.0" />
            </VBox.margin>
         </Button>

         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#userStatus" prefHeight="37.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 2; -fx-cursor: hand;" text="Book Catalog">
            <font>
               <Font size="14.0" />
            </font>
            <VBox.margin>
               <Insets bottom="15.0" />
            </VBox.margin>
         </Button>

         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#userHistory" prefHeight="37.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-border-width: 2; -fx-cursor: hand;" text="Reading History">
            <font>
               <Font size="14.0" />
            </font>
            <VBox.margin>
               <Insets bottom="40.0" />
            </VBox.margin>
         </Button>

         <!-- Logout Button -->
         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#userLogout" prefHeight="37.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="Logout">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </VBox>

      <!-- Content Area -->
      <AnchorPane fx:id="sceneShower" layoutX="220.0" layoutY="60.0" prefHeight="610.0" prefWidth="930.0" style="-fx-background-color: white;" />

      <!-- Top Bar -->
      <HBox alignment="CENTER_RIGHT" layoutX="220.0" layoutY="0.0" prefHeight="60.0" prefWidth="930.0" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets right="30.0" />
         </padding>
         <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Welcome, ">
            <font>
               <Font size="16.0" />
            </font>
         </Label>
         <Label fx:id="usernameLabel" style="-fx-text-fill: #3498db; -fx-font-weight: bold;" text="User">
            <font>
               <Font size="16.0" />
            </font>
         </Label>
      </HBox>
   </children>
</AnchorPane>
