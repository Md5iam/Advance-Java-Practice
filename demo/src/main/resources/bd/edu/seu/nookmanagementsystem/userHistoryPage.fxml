<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="610.0" prefWidth="930.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bd.edu.seu.nookmanagementsystem.User.userDeshboard.Features.userHistoryController">
   <children>
      <VBox layoutX="25.0" layoutY="20.0" spacing="15.0" prefWidth="880.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #2c3e50;" text="Your Reading &amp; Borrow History">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Text>

            <Button mnemonicParsing="false" onAction="#refreshHistory" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Refresh Log" />

            <TableView fx:id="historyDataTable" prefHeight="450.0" prefWidth="880.0" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-background-color: white; -fx-background-radius: 5; -fx-padding: 5;">
              <columns>
                <TableColumn fx:id="colNo" prefWidth="50.0" style="-fx-alignment: CENTER;" text="No" />
                <TableColumn fx:id="colId" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Book ID" />
                  <TableColumn fx:id="colTitle" prefWidth="250.0" style="-fx-alignment: CENTER_LEFT;" text="Title" />
                  <TableColumn fx:id="colAuthor" prefWidth="190.0" style="-fx-alignment: CENTER_LEFT;" text="Author" />
                  <TableColumn fx:id="colBorrowDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Borrow Date" />
                  <TableColumn fx:id="colReturnDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Return Date" />
                  <TableColumn fx:id="colStatus" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Status" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
